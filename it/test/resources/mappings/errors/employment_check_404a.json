{
    "priority": 2,
    "request": {
        "method": "GET",
        "urlPattern": "/apprenticeship-levy/employers/([a-zA-Z0-9%]+)/employed/([a-zA-Z0-9]+)",
        "headers": {
          "Authorization": {
              "matches": "Basic (.*)"
          },
          "X-Transmitting-System": {
              "equalTo": "HIP"
          }
        }
    },
    "response": {
        "status": 404,
        "jsonBody": {
          "reason": "Not found"
        }
    }
}