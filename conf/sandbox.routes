GET        /                                    controllers.sandbox.SandboxRootController.root
GET        /epaye/:empref                       controllers.sandbox.SandboxEmprefController.empref(empref: EmploymentReference)
GET        /epaye/:empref/declarations          controllers.sandbox.SandboxLevyDeclarationController.declarations(empref: EmploymentReference, fromDate: Option[LocalDate], toDate: Option[LocalDate])
GET        /epaye/:empref/fractions             controllers.sandbox.SandboxFractionsController.fractions(empref: EmploymentReference, fromDate: Option[LocalDate], toDate: Option[LocalDate])
GET        /fraction-calculation-date           controllers.sandbox.SandboxFractionsController.fractionCalculationDate
GET        /epaye/:empref/employed/:nino        controllers.sandbox.SandboxEmploymentCheckController.check(empref: EmploymentReference, nino: Nino, fromDate: LocalDate, toDate: LocalDate)
