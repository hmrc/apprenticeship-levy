# microservice specific routes

GET        /                                            controllers.live.LiveRootController.root
GET        /epaye/:empref                               controllers.live.LiveEmprefController.empref(empref: EmploymentReference)
GET        /epaye/:empref/declarations                  controllers.live.LiveLevyDeclarationController.declarations(empref: EmploymentReference, fromDate: Option[LocalDate], toDate: Option[LocalDate])
GET        /epaye/:empref/fractions                     controllers.live.LiveFractionsController.fractions(empref: EmploymentReference,fromDate: Option[LocalDate], toDate: Option[LocalDate])
GET        /fraction-calculation-date                   controllers.live.LiveFractionsCalculationDateController.fractionCalculationDate
GET        /epaye/:empref/employed/:nino                controllers.live.LiveEmploymentCheckController.check(empref: EmploymentReference, nino: Nino, fromDate: LocalDate, toDate: LocalDate)
