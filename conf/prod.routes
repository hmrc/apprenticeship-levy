# Add all the application routes to the app.routes file
->         /                                            config.ConditionalRouter
->         /                                            health.Routes
GET        /api/definition                              controllers.DocumentationController.definition()
GET        /api/documentation/:version/:endpoint        controllers.DocumentationController.documentation(version, endpoint)
GET        /api/conf/:version/*file                     controllers.DocumentationController.conf(version, file)
GET        /sandbox/data/*req                           @controllers.sandbox.data.SandboxTestDataController.serve(req)
